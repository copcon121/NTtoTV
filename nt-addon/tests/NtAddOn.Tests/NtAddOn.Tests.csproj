<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Property-based + unit test project for the NT_AddOn (Req: design Testing
    Strategy). Uses FsCheck for property-based testing (>= 100 iterations) per
    the design's "NT_AddOn (C#): FsCheck (or CsCheck)" decision, with xUnit as
    the runner.

    Property tests are tagged in the exact format required by the design:
        Feature: gc-chart-platform, Property {n}: {text}

    Targets net48 so the same .NET Framework family as the NinjaTrader 8 AddOn
    is exercised; it references only NtAddOn.Core (no NinjaTrader dependency),
    so it builds and runs without NinjaTrader installed.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>NtAddOn.Tests</RootNamespace>
    <AssemblyName>NtAddOn.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FsCheck" Version="2.16.6" />
    <PackageReference Include="FsCheck.Xunit" Version="2.16.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NtAddOn.Core\NtAddOn.Core.csproj" />
  </ItemGroup>

</Project>
