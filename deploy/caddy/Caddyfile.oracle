http://oracle.gcflowpy.xyz {
    encode zstd gzip

    handle /health {
        rewrite * /api/health
        reverse_proxy 127.0.0.1:8001
    }

    handle /ready {
        rewrite * /api/ready
        reverse_proxy 127.0.0.1:8001
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8001
    }

    handle /ws/chart* {
        reverse_proxy 127.0.0.1:8001
    }

    handle /ws/* {
        respond `{"error":{"code":"NOT_FOUND","message":"WebSocket endpoint not found"}}` 404
    }

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache, no-store, must-revalidate"

    handle {
        root * /opt/nttotv/current/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
